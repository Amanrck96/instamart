    "rules": "storage.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules.json",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "rules": "auth.rules.json"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
